<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Donation Form</title>
</head>

<body>
  <h1>Donation Form</h1>

  <form>

    <label for="full-name">Full Name:</label>
    <input
      type="text"
      id="full-name"
      name="name"
      placeholder="e.g., John Doe"
      required
      size="20"
    >

    <br><br>

    <label for="email">Email Address:</label>
    <input
      id="email"
      type="email"
      name="email"
      placeholder="example@email.com"
      required
    >

    <br><br>

    <label for="dollars">Donation Amount ($):</label>
    <input
      id="dollars"
      type="number"
      name="amount"
      placeholder="donation amount"
      min="1"
      max="10000"
      required
    >

    <br><br>

    <input
      type="checkbox"
      id="newsletter"
      name="newsletter"
    >
    <label for="newsletter">Subscribe</label>

    <br><br>

    <input
      type="submit"
      id="submit"
      value="Send"
    >

  </form>
</body>
</html>